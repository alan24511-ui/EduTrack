# Copia este archivo como backend/.env y rellena los valores reales.
# backend/.env está en .gitignore: no lo subas al repositorio.

# --- PostgreSQL (ya usado por app/database.py) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=edutrack
DATABASE_USER=postgres
DATABASE_PASSWORD=

# --- Supabase Auth ---
# Settings > API > Project URL
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Settings > API > Project API keys > anon public
SUPABASE_ANON_KEY=TU_ANON_KEY
# No configures SUPABASE_SERVICE_ROLE_KEY: no se necesita y nunca debe llegar al frontend.
# Los códigos OTP de registro y recuperación los envía Supabase Auth.
# Gmail SMTP se configura en Supabase Dashboard > Authentication > SMTP Settings,
# no aquí: no guardes la contraseña de Gmail en este archivo ni en Angular.
# Guía del proyecto: backend/CONFIGURAR_GMAIL_SUPABASE.md

# --- Vinculación ---
# Minutos de validez de un código de vinculación.
VINCULACION_CODIGO_EXPIRACION_MINUTOS=15
# --- CORS (orígenes permitidos, separados por coma) ---
CORS_ORIGINS=http://localhost:4200

# Token de ingestión compartido únicamente entre FastAPI y el servicio local (generar uno aleatorio).
RFID_INGEST_TOKEN=

# --- Firebase Cloud Messaging (opcional; secretos solo en backend/Render) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pega la clave privada completa; si se almacena con \n literales, el backend los normaliza.
FIREBASE_PRIVATE_KEY=

# --- Resend (para correos generados por la aplicación) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Frontend público (configurar en Vercel; no es un secreto) ---
EDUTRACK_API_URL=http://localhost:8000
# Vercel/Firebase web: variables públicas inyectadas en runtime-config.js durante el build.
# FIREBASE_WEB_API_KEY=
# FIREBASE_WEB_AUTH_DOMAIN=
# FIREBASE_WEB_PROJECT_ID=
# FIREBASE_WEB_STORAGE_BUCKET=
# FIREBASE_WEB_MESSAGING_SENDER_ID=
# FIREBASE_WEB_APP_ID=
# FIREBASE_WEB_VAPID_KEY=
